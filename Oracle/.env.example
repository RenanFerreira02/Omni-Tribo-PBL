# Credenciais do Oracle para a Fase 6. Copie para Oracle/.env e preencha.
# Oracle/.env NUNCA é versionado: o .gitignore da raiz ignora ".env" em qualquer pasta.

# Instância da FIAP. Confirme o SID no portal do aluno; o formato é host:porta:SID.
ORACLE_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL

# Usuário do aluno (rm + número do RM).
ORACLE_USER=

# Senha do schema. Sem valor aqui, de propósito.
ORACLE_PASSWORD=
