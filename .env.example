# =============================================================================
# Variáveis do container do banco (docker-compose.yml → env_file: .env)
#
# O Makefile COPIA este arquivo para `.env` sozinho, no primeiro `make up`. Não
# edite o `.env` gerado esperando que ele volte para o git: `.env` é local e não
# é versionado; este `.env.example` é o que fica no repositório.
#
# Estes valores são de DESENVOLVIMENTO e são versionados de propósito — mesma
# política das chaves RSA de dev: um clone novo sobe e funciona sem passo
# manual. Nada aqui alcança produção, onde o datasource vem de variável de
# ambiente sem default (ver `application.yml`, que declara DATASOURCE_URL sem
# valor padrão justamente para falhar alto se ninguém a definir).
# =============================================================================

# Banco criado pelo entrypoint da imagem postgis/postgis.
POSTGRES_DB=omnitribo

# O DONO das tabelas. É com ele que o FLYWAY conecta, porque migration é DDL e
# o papel da aplicação não tem essa permissão — ver `application-dev.yml`.
#
# A aplicação NÃO usa este usuário: ela conecta como `omnitribo_app`, um papel
# restrito que a V2 cria e que não tem UPDATE nem DELETE nas tabelas
# append-only. É essa separação que faz o REVOKE das migrations valer em
# runtime, e há teste que a exercita de verdade (MigracaoTest
# .aplicacao_nao_consegue_apagar_nem_alterar_o_ledger_em_runtime).
POSTGRES_USER=omnitribo
POSTGRES_PASSWORD=omnitribo_dev
